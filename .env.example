# ── أكاديمية رحيق — متغيرات البيئة ─────────────────────────
# انسخ الملف إلى .env وعدّل القيم. `.env` مُستثنى من Git.
# الخادم المحلي (serve.py) يحمّل `.env` تلقائيًا ويمرّر البيئة إلى خادم Node.

# ── الذكاء الاصطناعي (xAI Grok أو Groq + بدائل) ──
# ضع مفتاحًا واحدًا على الأقل. الكود يكتشف المزود من بداية المفتاح تلقائيًا:
#   xai-...  => xAI Grok  — المفتاح من https://console.x.ai  (API Keys)
#   gsk_...  => Groq      — المفتاح من https://console.groq.com/keys
#   sk-or-... => OpenRouter · AIza... => Gemini · OPENAI_API_KEY => OpenAI
# في Vercel: Settings ← Environment Variables ← أضف المتغير ثم Deployments ← Redeploy.
# بعد النشر افتح /api/yaseen-ai-status للتأكد إن الحالة "working".
# يمكن وضع أكثر من مفتاح مفصولين بفاصلة للتبديل التلقائي: xai-...,gsk_...
XAI_API_KEY=
GROQ_API_KEY=
# (يقرأ أيضًا GROK_API_KEY و AI_API_KEY و API_KEY وأي متغير قيمته مفتاح xai- أو gsk_)

# الموديل (اختياري — اتركه فارغًا ليختار الكود أحدث موديل متاح تلقائيًا).
# الافتراضي: Grok => grok-4.3 ثم grok-4.20-0309-non-reasoning ثم grok-4.7
#            Groq => openai/gpt-oss-120b ثم openai/gpt-oss-20b ثم qwen/qwen3.8-27b
# الموديلات المتقاعدة (grok-2-latest / grok-beta / llama-3.3-70b-versatile ...) تتخطى تلقائيًا،
# ولو تقاعد الموديل مستقبلًا يكتشف الكود المتاح للمفتاح من /models بنفسه.
# GROK_MODEL=grok-4.3
# GROQ_MODEL=openai/gpt-oss-120b
# اضبطها 0 لإطفاء الذكاء الاصطناعي دون حذف المفتاح
GROQ_AI=1
# مهلة المحاولة الواحدة بالمللي ثانية (افتراضي 12000) والمهلة الإجمالية لكل رد (افتراضي 16000)
# GROQ_TIMEOUT_MS=12000
# AI_BUDGET_MS=16000

# ── رحيق: التخزين والأمان ──
# سر التشفير للمخزن وتوقيع ذاكرة المحادثة (16+ حرف).
# ولّده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YASEEN_SECRET=
# YASEEN_DATA_DIR=/var/lib/raheeq/yaseen
# إيقاف طارئ للبوت دون حذف شيء
# YASEEN_ENABLED=0

# حساب المدير (بديل عن إعداد server/yaseen-admin-setup.js — مفيد لـ Vercel)
# YASEEN_ADMIN_EMAIL=admin@example.com
# YASEEN_ADMIN_NAME=مدير الأكاديمية
# YASEEN_ADMIN_PASSWORD_HASH=$2b$12$...
# YASEEN_ADMIN_TOTP_SECRET=...

# قاعدة Upstash Redis / Vercel KV لحفظ تعديلات المدير (اختياري — وإلا تخزين ملف محلي)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
