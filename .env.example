# ── أكاديمية رحيق — متغيرات البيئة ─────────────────────────
# انسخ الملف إلى .env وعدّل القيم. `.env` مُستثنى من Git.
# الخادم المحلي (serve.py) يحمّل `.env` تلقائيًا ويمرّر البيئة إلى خادم Node.

# ── الذكاء الاصطناعي (Groq + متعدد المزودين والأدوات) ──
# مفتاح من https://console.groq.com/keys (صيغة gsk_...)
# يمكنك أيضًا وضع أكثر من مفتاح مفصولين بفاصلة للتبديل التلقائي عند الضغط: gsk_...,gsk_...
# كما يدعم الكود تلقائيًا مفاتيح xAI Grok (xai-...) و OpenRouter (sk-or-...) و Gemini و OpenAI
# ويقرأ أي اسم بديل في Vercel (مثل GROQ_API_KEY أو GROK_API_KEY أو AI_API_KEY أو API_KEY).
GROQ_API_KEY=
# الموديل (اختياري). الافتراضي في Groq: llama-3.3-70b-versatile (مع موديلات احتياطية تلقائية)
GROQ_MODEL=llama-3.3-70b-versatile
# اضبطها 0 لإطفاء الذكاء الاصطناعي دون حذف المفتاح
GROQ_AI=1
# مهلة النداء بالمللي ثانية (افتراضي 11000)
GROQ_TIMEOUT_MS=11000

# ── رحيق: التخزين والأمان ──
# سر التشفير للمخزن وتوقيع ذاكرة المحادثة (16+ حرف).
# ولّده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YASEEN_SECRET=
# YASEEN_DATA_DIR=/var/lib/raheeq/yaseen
# إيقاف طارئ للبوت دون حذف شيء
# YASEEN_ENABLED=0

# حساب المدير (بديل عن إعداد server/yaseen-admin-setup.js — مفيد لـ Vercel)
# YASEEN_ADMIN_EMAIL=admin@example.com
# YASEEN_ADMIN_NAME=مدير الأكاديمية
# YASEEN_ADMIN_PASSWORD_HASH=$2b$12$...
# YASEEN_ADMIN_TOTP_SECRET=...

# قاعدة Upstash Redis / Vercel KV لحفظ تعديلات المدير (اختياري — وإلا تخزين ملف محلي)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
