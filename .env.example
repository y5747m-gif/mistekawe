# ── أكاديمية رحيق — متغيرات البيئة ─────────────────────────
# انسخ الملف إلى .env وعدّل القيم. `.env` مُستثنى من Git.
# الخادم المحلي (serve.py) يمرّر البيئة تلقائيًا إلى خادم Node.

# ── الذكاء الاصطناعي (Groq) — اختياري؛ بدونه رحيق تعمل بمحرك القواعد (أسئلة التسجيل فقط،
#    وأي سؤال آخر يرد باعتذار مهذب «المساعد الذكي مش متاح دلوقتي»). بضبطه: ردود على أي سؤال. ──
# مفتاح من https://console.groq.com/keys  (صيغة gsk_...)
GROQ_API_KEY=
# الموديل (اختياري). الافتراضي: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
# اضبطها 0 لإطفاء الاصطناعي دون حذف المفتاح
GROQ_AI=1
# مهلة نداء Groq بالمللي ثانية (افتراضي 7000)
GROQ_TIMEOUT_MS=7000

# ── رحيق: التخزين والأمان ──
# سر التشفير للمخزن (16+ حرف). ولّده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YASEEN_SECRET=
# YASEEN_DATA_DIR=/var/lib/raheeq/yaseen
# إيقاف طارئ للبوت دون حذف شيء
# YASEEN_ENABLED=0

# حساب المدير (بديل عن إعداد server/yaseen-admin-setup.js — مفيد لـ Vercel)
# YASEEN_ADMIN_EMAIL=admin@example.com
# YASEEN_ADMIN_NAME=مدير الأكاديمية
# YASEEN_ADMIN_PASSWORD_HASH=$2b$12$...
# YASEEN_ADMIN_TOTP_SECRET=...

# قاعدة Upstash Redis / Vercel KV لحفظ تعديلات المدير (اختياري — وإلا تخزين ملف محلي)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
