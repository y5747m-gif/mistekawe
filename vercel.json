{
  "functions": {
    "api/yaseen.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/yaseen-config",
      "destination": "/api/yaseen?__r=config"
    },
    {
      "source": "/api/yaseen-chat",
      "destination": "/api/yaseen?__r=chat"
    },
    {
      "source": "/api/yaseen-ai-status",
      "destination": "/api/yaseen?__r=ai-status"
    },
    {
      "source": "/api/yaseen-admin/:action",
      "destination": "/api/yaseen?__r=admin-:action"
    }
  ],
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/raheeq",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/api/_yaseen/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/server/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tests/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.git/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.github/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.gitignore",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "bluetooth=(self), microphone=(self), speaker-selection=(self), autoplay=(self)"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://www.google-analytics.com https://*.google-analytics.com; media-src 'self' blob:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(assets|sounds|icons|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:webp|png|jpg|jpeg|svg|ico|woff2|woff|mp3|wav|webmanifest))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin-yaseen/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
